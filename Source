function GetNearestATM()
	local CLOSEST_ATM, CLOSEST_ATM_MAG = nil, math.huge
	for _, ATM in workspace:GetChildren() do
		if ATM.Name == "ATM NEW" then
			local Magnitude = (ATM:GetPivot().Position - LocalPlayer.Character.PrimaryPart.Position).Magnitude
			if Magnitude < CLOSEST_ATM_MAG then CLOSEST_ATM = ATM CLOSEST_ATM_MAG = Magnitude end
		end
	end
	return CLOSEST_ATM
end

