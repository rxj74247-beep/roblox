function CharacterAdded(Char)
	if not Char:FindFirstChildOfClass("Humanoid") then repeat task.wait(.1) until Char:FindFirstChildOfClass("Humanoid") end

	for _, conn in pairs(CharacterConnections) do
		pcall(function()
			conn:Disconnect()
		end)
	end

	if LastAliveCFrame ~= nil then
		spawn(function()
			local STARTED_SPAWNING = os.clock()
			local SPAWN_TIME = 1
			while (os.clock() - STARTED_SPAWNING) <= SPAWN_TIME do
				Char:PivotTo(LastAliveCFrame)
				task.wait()
				if (os.clock() - STARTED_SPAWNING) >= SPAWN_TIME then
					break
				end
			end
		end)
	end

	local IsRespawning = false

	local function RespawnCharacter()
		if IsRespawning then return end
		IsRespawning = true
		print("Respawning...")
		repeat
			ReplicatedStorage:WaitForChild("RequestRespawn"):FireServer("Random")
			task.wait()
			if LocalPlayer.Character ~= nil and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") ~= nil and LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
				break
			end
		until LocalPlayer.Character ~= nil and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") ~= nil and LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health > 0
	end

	local Humanoid = Char:FindFirstChildOfClass("Humanoid") :: Humanoid
	local DiedConnection; DiedConnection = Humanoid.Died:Connect(RespawnCharacter)
	local HealthChangedConnection; HealthChangedConnection = Humanoid:GetPropertyChangedSignal("Health"):Connect(function()
		if Humanoid.Health <= 0 then
			RespawnCharacter()
		end
	end)

	local MovedConnection; MovedConnection = Humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
		if LocalPlayer.Character ~= nil and LocalPlayer.Character.PrimaryPart ~= nil and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") ~= nil and LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
			LastAliveCFrame = LocalPlayer.Character:GetPivot()
		end
	end)

	table.insert(CharacterConnections, DiedConnection)
	table.insert(CharacterConnections, HealthChangedConnection)
	table.insert(CharacterConnections, MovedConnection)

end

