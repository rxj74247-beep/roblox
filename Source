		BankStatusLabel.Text = RobberyOpenStatuses.Bank and string.format(OpenStatusFormat, "Bank") or string.format(CloseStatusFormat, "Bank")
		RoyalCasinoStatusLabel.Text = RobberyOpenStatuses.Casino and string.format(OpenStatusFormat, "Royal Casino") or string.format(CloseStatusFormat, "Royal Casino")
		BoxedIceStatusLabel.Text = RobberyOpenStatuses.BoxedIce and string.format(OpenStatusFormat, "Boxed Ice") or string.format(CloseStatusFormat, "Boxed Ice")
	end
end

ReplicatedStorage:WaitForChild("NotificationClient").OnClientEvent:Connect(function(DataTable)
	if DataTable ~= nil and typeof(DataTable) == "table" and DataTable[3] == "Top" then
		local LOWERED_STRING = string.lower(tostring(DataTable[2]))
		if DataTable[1] == "success" and string.find(LOWERED_STRING, "open") ~= nil then
			if string.find(LOWERED_STRING, "casino") ~= nil then RobberyOpenStatuses.Casino = true UpdateRobberyStatuses() return end
			if string.find(LOWERED_STRING, "bank") ~= nil then RobberyOpenStatuses.Bank = true UpdateRobberyStatuses() return end
			if string.find(LOWERED_STRING, "boxed ice") ~= nil then RobberyOpenStatuses.BoxedIce = true UpdateRobberyStatuses() return end
		elseif DataTable[1] == "alert" and string.find(LOWERED_STRING, "robbed") ~= nil then
			if string.find(LOWERED_STRING, "casino") ~= nil then RobberyOpenStatuses.Casino = false RoyalCasinoStatusLabel.Text = string.format(CloseStatusFormat, "Royal Casino") return end
			if string.find(LOWERED_STRING, "bank") ~= nil then RobberyOpenStatuses.Bank = false BankStatusLabel.Text = string.format(CloseStatusFormat, "Bank") return end
			if string.find(LOWERED_STRING, "boxed ice") ~= nil then RobberyOpenStatuses.BoxedIce = false BoxedIceStatusLabel.Text = string.format(CloseStatusFormat, "Boxed Ice") return end
		end
	end
end)

function RobBoxedIce()
	local Character = LocalPlayer.Character
	if not Character or not Character:FindFirstChildOfClass("Humanoid") then return false end
	if not RobberyOpenStatuses.BoxedIce then return false end
	TeleportCharacter(Vector3.new(279, 5, -242))
	task.wait()
	local CooldownGui = workspace.TeleportsBack:FindFirstChild("BoxedIce") and workspace.TeleportsBack.BoxedIce:FindFirstChild("Cooldown")
	if CooldownGui == nil or CooldownGui.Enabled ~= false then return false end
	for i = 1, 3 do TeleportCharacter(Vector3.new(-658, -407, -806)) task.wait(0.15) end
	local Equipped_Weapon = EnsureEquippedWeapon()
	if Equipped_Weapon ~= nil then game:GetService("ReplicatedStorage"):WaitForChild("GunRemotes"):WaitForChild("Slide"):FireServer(Equipped_Weapon, true) end
	game:GetService("ReplicatedStorage"):WaitForChild("GunRemotes"):WaitForChild("Fire"):FireServer()
	if workspace.RobberyData:FindFirstChild("BoxedIceData") == nil then
		local ATTEMPTS = 10
		repeat
			ATTEMPTS -= 1
			if ATTEMPTS <= 0 then break end
			TeleportCharacter(Vector3.new(279, 5, -242))
			task.wait(1)
			if workspace.RobberyData:FindFirstChild("BoxedIceData") ~= nil then break end
		until workspace.RobberyData:FindFirstChild("BoxedIceData") ~= nil
	end
	local GlassToBreak = workspace.RobberyData.BoxedIceData:GetChildren()
	local RobberyLootVal = LocalPlayer:FindFirstChild("RobberyLoot")
	for _, v in ipairs(GlassToBreak) do
		if v.Name == "BreakableGlass" and v:FindFirstChild("HP") then
			if RobberyLootVal and RobberyLootVal.Value >= MAX_ROBBERY_LOOT then break end
			if IsLastRobberyBoxedIce() then return false end
			if v:FindFirstChild("HP").Value > 0 then
				local ATTEMPTS = 80
				repeat
					if IsLastRobberyBoxedIce() then return false end
					if ATTEMPTS <= 0 then break end
					if RobberyLootVal and RobberyLootVal.Value >= MAX_ROBBERY_LOOT then break end
					Equipped_Weapon = EnsureEquippedWeapon()
					TeleportCharacter(v.Position + Vector3.new(math.random(-25,25)/50, math.random(-25,25)/50, math.random(-25,25)/50))
					game:GetService("ReplicatedStorage"):WaitForChild("GunRemotes"):WaitForChild("Impact"):FireServer(v, v.Position, Vector3.new(628.9044189453125, -390.31414794921875, -1304.658935546875), Vector3.new(-0.03484940528869629, 0, 0.999392569065094))
				until v:FindFirstChild("HP").Value <= 0
			end
			for _, v2 in pairs(v:GetChildren()) do
				if v2:IsA("BasePart") and v2:FindFirstChildOfClass("ProximityPrompt") then
					local CollectPrompt = v2:FindFirstChildOfClass("ProximityPrompt")
					TeleportCharacter(v2.Position - Vector3.new(0.25, 0.25, 0))
					local ATTEMPTS = 80
					repeat
						if ATTEMPTS <= 0 then break end
						ATTEMPTS -= 1
						if workspace:WaitForChild("RobberyData"):WaitForChild("BoxedIceData"):WaitForChild("Robbing").Value ~= true then return false end
						if IsLastRobberyBoxedIce() then return false end
						RobberyLootVal = LocalPlayer:FindFirstChild("RobberyLoot")
						if RobberyLootVal and RobberyLootVal.Value >= MAX_ROBBERY_LOOT then break end
						TeleportCharacter(v2.Position + Vector3.new(math.random(-25,25)/100, math.random(-25,25)/100, math.random(-25,25)/100))
						fireproximityprompt(CollectPrompt)
						task.wait(0.05)
						if RobberyLootVal == nil then RobberyLootVal = LocalPlayer:FindFirstChild("RobberyLoot") end
					until not CollectPrompt or not CollectPrompt.Enabled or not v2 or v2.Transparency == 1
				end
			end
		end
	end
	SellRobberyLoot()
	return true
end

