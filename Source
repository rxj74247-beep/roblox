function SafeTeleport(Position)
	if lastPlatform and lastPlatform.Parent then lastPlatform:Destroy() end
	if lastAntiFall and lastAntiFall.Parent then lastAntiFall:Destroy() end
	local Character = LocalPlayer.Character
	if Character and Character.PrimaryPart then
		local platform = Instance.new("Part")
		platform.Size = Vector3.new(120, 3, 120)
		platform.Anchored = true
		platform.CanCollide = true
		platform.Transparency = 0.5
		platform.Position = Position - Vector3.new(0, 4.5, 0)
		platform.Parent = workspace
		lastPlatform = platform
		local bv = Instance.new("BodyVelocity")
		bv.Name = "AntiFall"
		bv.MaxForce = Vector3.new(0, 100000, 0)
		bv.Velocity = Vector3.new(0, 2, 0)
		bv.Parent = Character.PrimaryPart
		lastAntiFall = bv
		task.delay(2.5, function()
			if bv and bv.Parent then bv:Destroy() end
		end)
	end
	local Character = LocalPlayer.Character
	local SuccessSetPPCf = pcall(function() Character:PivotTo(CFrame.new(Position)) end)
	if not SuccessSetPPCf then pcall(function() if Character then Character:SetPrimaryPartCFrame(CFrame.new(Position)) end end) end
end

function TeleportCharacter(Position)
	LAST_TELEPORTED_POSITION = Position
	local tries = 0
	while true do
		SafeTeleport(Position)
		task.wait(.02)
		tries = tries + 1
		local Character = LocalPlayer.Character
		if Character == nil or Character:FindFirstChildOfClass("Humanoid") == nil then break end
		if Character.PrimaryPart == nil then break end
		if (Character.PrimaryPart.Position - Position).Magnitude < 25 then break end
		if tries > 80 then break end
	end
end

