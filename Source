local function IsVisible(From, To, Target)
	if typeof(From) ~= "Vector3" or typeof(To) ~= "Vector3" then return false end
	local Direction = To - From
	local Distance = Direction.Magnitude
	if Distance <= 0.001 then return true end
	local Ignored = {}
	if LocalPlayer and LocalPlayer.Character then Ignored[#Ignored + 1] = LocalPlayer.Character end
	if workspace.CurrentCamera then Ignored[#Ignored + 1] = workspace.CurrentCamera end
	local Params = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.IgnoreWater = true
	for _ = 1, 50 do
		Params.FilterDescendantsInstances = Ignored
		local Result = workspace:Raycast(From, Direction, Params)
		if not Result then return true end
		local Hit = Result.Instance
		if Target and Hit and Hit:IsDescendantOf(Target) then return true end
		if (Result.Position - To).Magnitude <= 0.35 then return true end
		if Hit and Hit:IsA("BasePart") and Hit.Transparency >= 0.95 then Ignored[#Ignored + 1] = Hit else return false end
	end
	return false
end

