function RobBank()
	if LocalPlayer.Character == nil or LocalPlayer.Character:FindFirstChildOfClass("Humanoid") == nil then return false end
	if LocalPlayer.Character:FindFirstChild("Drill") == nil and LocalPlayer.Backpack:FindFirstChild("Drill") == nil then return false end
	if not RobberyOpenStatuses.Bank then return false end
	local PLACE_DRILL_POS = Vector3.new(-490, -255, -200)
	local SAFE_POS = Vector3.new(-488, -271, -271)
	for i = 1, 3 do TeleportCharacter(PLACE_DRILL_POS) task.wait(0.15) end
	local DrillModel = workspace:WaitForChild("RobberyData"):WaitForChild("BankData"):WaitForChild("Drill")
	if DrillModel == nil then return false end
	local DrillPrompt = DrillModel.Handle:FindFirstChildOfClass("ProximityPrompt")
	if DrillPrompt == nil then return false end
	if DrillPrompt ~= nil and DrillPrompt.Enabled == true and workspace.RobberyData.BankData.Robbing.Value == false then
		repeat
			if DrillPrompt == nil or DrillPrompt.Enabled == false or workspace.RobberyData.BankData.Robbing.Value == true then break end
			TeleportCharacter(PLACE_DRILL_POS)
			EquipDrill()
			task.wait(.25)
			if DrillPrompt == nil or DrillPrompt.Enabled == false or workspace.RobberyData.BankData.Robbing.Value == true then break end
			fireproximityprompt(DrillPrompt)
			task.wait(.25)
			if DrillPrompt == nil or DrillPrompt.Enabled == false or workspace.RobberyData.BankData.Robbing.Value == true then break end
			task.wait(.25)
		until DrillPrompt == nil or DrillPrompt.Enabled == false or workspace.RobberyData.BankData.Robbing.Value == true
	end
	for i = 1, 3 do TeleportCharacter(SAFE_POS) task.wait(0.15) end
	local IsVisibleGoldBar = false
	for _, v in pairs(workspace.RobberyData.BankData.GoldBricks:GetChildren()) do if v.Transparency ~= 1 then IsVisibleGoldBar = true break end end
	if IsVisibleGoldBar == false then return false end
	repeat task.wait() until workspace.RobberyData.BankData.GoldBricks:FindFirstChild("StealBankItem", true) ~= nil and workspace.RobberyData.BankData.GoldBricks:FindFirstChild("StealBankItem", true):IsA("ProximityPrompt")
	local RobberyLootVal = LocalPlayer:FindFirstChild("RobberyLoot")
	local ATTEMPTS = 80
	while workspace.RobberyData.BankData.GoldBricks:FindFirstChild("StealBankItem", true) ~= nil do
		if ATTEMPTS <= 0 then break end
		ATTEMPTS -= 1
		if workspace:WaitForChild("RobberyData"):WaitForChild("BankData"):WaitForChild("Robbing").Value ~= true then return false end
		if IsLastRobberyBank() then return false end
		local StealPrompt = workspace.RobberyData.BankData.GoldBricks:FindFirstChild("StealBankItem", true)
		TeleportCharacter(StealPrompt.Parent.Position + Vector3.new(math.random(-25,25)/100, math.random(-25,25)/100, math.random(-25,25)/100))
		fireproximityprompt(StealPrompt)
		task.wait()
		RobberyLootVal = LocalPlayer:FindFirstChild("RobberyLoot")
		if RobberyLootVal and RobberyLootVal.Value >= MAX_ROBBERY_LOOT then break end
	end
	SellRobberyLoot()
	return true
end

