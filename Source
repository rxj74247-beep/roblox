			local SUCCESS_ROB_BANK, ERROR_ROB_BANK = pcall(function() SuccessRobBank = RobBank() end)
			CurrentlyRobbing = false
			if (not SUCCESS_ROB_BANK) and SERVER_HOP_ENABLED == true then warn("Error while robbing bank: ".. tostring(ERROR_ROB_BANK)) HopServer() break end
		end
	end
	EnsureEquippedWeapon()
	CurrentStatusLabel.Text = "Current Status: Cleaning illegal cash"
	task.wait()
	if LocalPlayerHasIllegalCash() then
		local CleanedCash = CleanIllegalCash()
		if CleanedCash == true then CurrentStatusLabel.Text = "Current Status: Successfully cleaned illegal cash!" task.wait(.5) end
		task.wait()
	end
	if WalletValue.Value > 10000 then
		CurrentStatusLabel.Text = "Current Status: Depositing cash"
		task.wait()
		local DepositedCash = DepositCash(math.max(0, WalletValue.Value - 10000))
		if DepositedCash == true then CurrentStatusLabel.Text = "Current Status: Successfully deposited cash!" task.wait(.5) end
	end
	if not SuccessRobBank and not SuccessRobCasino and not SuccessRobBoxedIce then
		if SERVER_HOP_ENABLED == true then
			CurrentStatusLabel.Text = "Current Status: Hopping servers..."
			HopServer()
		end
	end
	EnsureEquippedWeapon()
	CurrentStatusLabel.Text = "Current Status: Waiting"
	task.wait()
end
