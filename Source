end

local function ReadLocal(name)
	if isfile and readfile and isfile("slr_" .. name .. ".json") then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(readfile("slr_" .. name .. ".json"))
		end)
		if ok then return decoded end
	end
	return nil
end

