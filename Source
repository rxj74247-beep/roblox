local function CanHopNow()
	local data = ReadLocal("lasthop")
	if type(data) ~= "table" or not data.t then
		return true, 0
	end
	local elapsed = os.time() - data.t
	local cooldown = 0
	if elapsed >= cooldown then
		return true, 0
	end
	return false, cooldown - elapsed
end

local function getHighServers()
	local pid = game.PlaceId
	local function getservers(curs)
		local u = "https://games.roblox.com/v1/games/"..pid.."/servers/Public?sortOrder=Desc&limit=100"
		if curs then u = u.."&cursor="..curs end
		local req = request or http_request or (syn and syn.request)
		local r = req({Url = u, Method = "GET"})
		return HttpService:JSONDecode(r.Body)
	end
	local high = {}
	local cursor = nil
	for i = 1, 10 do
		local data = getservers(cursor)
		if not data or not data.data then break end
		for _, s in ipairs(data.data) do
			if s.id and s.playing and s.maxPlayers and s.playing >= 6 and s.playing < s.maxPlayers and s.id ~= game.JobId then
				table.insert(high, s.id)
			end
		end
		cursor = data.nextPageCursor
		if not cursor then break end
	end
	return high
end

local function MarkHop()
	WriteLocal("lasthop", {t = os.time()})
end

function HopServer(forceRefresh)
	if SERVER_HOP_ENABLED ~= true then return end
	if hopping then return end

	local waitStart = tick()
	while CurrentlyRobbing do
		task.wait(0.5)
		if tick() - waitStart > 90 then break end
	end

	local can, rem = CanHopNow()
	if not can then
		task.spawn(function()
			task.wait(rem + 0.5)
			hopping = false
			HopServer(forceRefresh)
		end)
		return
	end

	hopping = true
	MarkHop()
	local pid = game.PlaceId
	local now = os.time()

	local meta = ReadLocal("servers") or {list = {}, lastFetch = 0}
	if type(meta) ~= "table" then meta = {list = {}, lastFetch = 0} end
	local list = meta.list or {}

	if forceRefresh or #list < 5 or (now - (meta.lastFetch or 0)) > (60*30) then
		list = getHighServers()
		meta = {list = list, lastFetch = now}
		WriteLocal("servers", meta)
	end

	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end

	local target = nil
	while #list > 0 do
		local candidate = table.remove(list, 1)
		if candidate and candidate ~= game.JobId then
			target = candidate
			break
		end
	end

	meta.list = list
	WriteLocal("servers", meta)

	if not target then
		list = getHighServers()
		for i = #list, 2, -1 do
			local j = math.random(i)
			list[i], list[j] = list[j], list[i]
		end
		while #list > 0 do
			local candidate = table.remove(list, 1)
			if candidate and candidate ~= game.JobId then
				target = candidate
				break
			end
		end
	end

	if not target then
		pcall(function()
			LocalPlayer:Kick("Switching servers...")
			task.wait(3)
			TeleportService:Teleport(pid)
		end)
		hopping = false
		return
	end

	local failed = false
	local conn
	conn = TeleportService.TeleportInitFailed:Connect(function(plr, result, err)
		if plr == LocalPlayer then
			failed = true
			if conn then conn:Disconnect() end
			task.spawn(function()
				task.wait(4)
				hopping = false
				MarkHop()
				HopServer(true)
			end)
		end
	end)

	pcall(function()
		LocalPlayer:Kick("Switching servers...")
		task.wait(3)
		TeleportService:TeleportToPlaceInstance(pid, target)
	end)

	task.delay(14, function()
		if conn then conn:Disconnect() end
		if not failed then hopping = false end
	end)
end

