function CleanIllegalCash()
	for i = 1,4 do TeleportCharacter(Vector3.new(-375, -455, -349)) task.wait(0.15) end
	local IllegalCashAmount = math.floor(GetIllegalCashAmount())
	local E36 = workspace:FindFirstChild("e36")
	if E36 == nil then CurrentStatusLabel.Text = "Current Status: Cleaning failed - e36 not found" return false end
	local E36Prompt = E36:FindFirstChildOfClass("ProximityPrompt")
	if E36Prompt == nil or not E36Prompt.Enabled then CurrentStatusLabel.Text = "Current Status: Cleaning failed - prompt not ready" return false end
	if IllegalCashAmount < 1 then CurrentStatusLabel.Text = "Current Status: No illegal cash to clean" return false end
	local timeout = 0
	repeat
		TeleportCharacter(Vector3.new(-375, -455, -349))
		task.wait(0.05)
		fireproximityprompt(E36Prompt)
		task.wait(0.05)
		timeout = timeout + 1
		if timeout > 50 then CurrentStatusLabel.Text = "Current Status: Cleaning timeout - skipping" return false end
	until LocalPlayer.PlayerGui:FindFirstChild("LaundryGui")
	task.wait(0.05)
	game:GetService("ReplicatedStorage"):WaitForChild("UI"):WaitForChild("Laundry"):FireServer("Wash", IllegalCashAmount)
	task.wait(0.05)
	GlobalUIFunctions.SetBackground(1)
	ReplicatedStorage.UI.Laundry:FireServer("Exit")
	return true
end

